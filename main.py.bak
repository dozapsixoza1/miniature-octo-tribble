# Обработка поиска по номеру телефона
@dp.message(F.text == "📞 Номер телефона")
async def search_phone(message: Message, state: FSMContext):
    await state.set_state(Form.waiting_for_phone)
    await message.answer("📞 **Введите номер телефона:** (в формате +79991234567)")

# Обработка введенного номера телефона
@dp.message(Form.waiting_for_phone)
async def process_phone_search(message: Message, state: FSMContext):
    phone = message.text
    user_id = message.from_user.id

    # Проверяем лимит
    cursor.execute("SELECT search_limit FROM users WHERE user_id = ?", (user_id,))
    search_limit = cursor.fetchone()[0]

    if search_limit <= 0:
        await message.answer("❌ **Лимит поисков исчерпан.** Пополните баланс.")
        await state.clear()
        return

    # Уменьшаем лимит и увеличиваем счетчик
    cursor.execute(
        "UPDATE users SET search_limit = search_limit - 1, phone_searches = phone_searches + 1 WHERE user_id = ?",
        (user_id,),
    )
    conn.commit()

    # Проверяем номер через API
    await message.answer(f"🔎 **Ищем информацию по номеру:** `{phone}`...")
    api_result = await check_phone_number(phone)
    
    await message.answer(api_result)
    await state.clear()

